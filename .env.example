# Google Cloud OAuth 2.0 client (Desktop app type) — see docs/ONBOARDING.md
GOOGLE_DOCS_MCP_CLIENT_ID=
GOOGLE_DOCS_MCP_CLIENT_SECRET=

# Where the cached OAuth token is written (default: <repo>/data/token.json)
# GOOGLE_DOCS_MCP_TOKEN_PATH=

# Fixed local port for the OAuth loopback redirect (0 = OS picks a free port)
# GOOGLE_DOCS_MCP_OAUTH_PORT=0

# Webapp backend bind address/port (adjacent pair registered: 11972/11973)
# GOOGLE_DOCS_MCP_HOST=127.0.0.1
# GOOGLE_DOCS_MCP_PORT=11972

# Set to 0 to skip registering Prefab App tools (CI / headless images)
# GOOGLE_DOCS_MCP_PREFAB_APPS=1
