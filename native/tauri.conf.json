{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Google Docs MCP",
	"version": "0.1.0",
	"identifier": "com.sandraschi.google-docs-mcp",
	"build": {
		"beforeDevCommand": {
			"script": "bun run dev",
			"cwd": "../webapp"
		},
		"devUrl": "http://127.0.0.1:11973",
		"beforeBuildCommand": {
			"script": "bun run build",
			"cwd": "../webapp"
		},
		"frontendDist": "../webapp/dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Google Docs MCP",
				"width": 1280,
				"height": 860,
				"resizable": true
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:11972 ipc: http://ipc.localhost; img-src 'self' data: http://127.0.0.1:11972; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["icons/icon.png", "icons/icon.ico"],
		"resources": [
			"resources/google-docs-mcp-backend.exe",
			"resources/.env.example"
		],
		"windows": {
			"webviewInstallMode": {
				"type": "skip"
			},
			"nsis": {
				"installerHooks": "./windows/hooks.nsh",
				"installMode": "currentUser"
			}
		}
	},
	"plugins": {}
}
